+static int64_t slickrock_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static int slickrock_looper_poll_all(int timeout_ms)
+{
+   int result;
+   int64_t end_ns;
+
+   if (timeout_ms <= 0)
+   {
+      do
+      {
+         result = ALooper_pollOnce(timeout_ms, NULL, NULL, NULL);
+      } while (result == ALOOPER_POLL_CALLBACK);
+      return result;
+   }
+
+   end_ns = slickrock_now_ns() + (int64_t)timeout_ms * 1000000LL;
+
+   for (;;)
+   {
+      int64_t left_ns;
+
+      result = ALooper_pollOnce(timeout_ms, NULL, NULL, NULL);
+      if (result != ALOOPER_POLL_CALLBACK)
+         return result;
+
+      left_ns = end_ns - slickrock_now_ns();
+      if (left_ns <= 0)
+         return ALOOPER_POLL_TIMEOUT;
+      /* Round up, as the platform does. */
+      timeout_ms = (int)((left_ns + 999999LL) / 1000000LL);
+   }
