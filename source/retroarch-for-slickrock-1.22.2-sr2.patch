+/* Slickrock: input reader.
+ *
+ * Android hands a window one key event at a time and holds the next one
+ * until the window has finished the last (InputDispatcher: key events are
+ * serialized "with respect to all prior input events"). Stock 1.22.2 reads
+ * the input queue on the main thread once a frame, and a NativeActivity is
+ * handed every key twice: before the IME, marked AKEY_EVENT_FLAG_PREDISPATCH
+ * (0x20000000, frameworks/native Input.h), and again after the IME unless
+ * the first copy is finished handled. Stock finished the first copy
+ * unhandled, so every key cost two frames and an IME round trip before
+ * Android would send the next. Under mashing the dispatcher's queue grew
+ * without bound: on a Sidephone SP01, 97 keys waiting, the oldest 3.2 s,
+ * draining at 28 a second, and the game played presses back long after the
+ * hands had stopped.
+ *
+ * Here a thread of its own owns the queue. It copies each event and
+ * finishes it at once, handled, so Android sends the next one straight
+ * away, and neither the IME nor the second copy ever happens. The main
+ * thread applies the copies at its poll, oldest first, through the stock
+ * handlers. Volume keys stay the system's: finished unhandled, and read
+ * once, on their way back from the IME. */
+#ifndef SLICKROCK_AKEY_EVENT_FLAG_PREDISPATCH
+#define SLICKROCK_AKEY_EVENT_FLAG_PREDISPATCH 0x20000000
+#endif
+
+#define SR_RING 2048 /* events; a power of two */
+
+typedef struct sr_reader
+{
+   slock_t     *lock;     /* guards queue, head, tail, dropped, ring */
+   scond_t     *cond;
+   sthread_t   *thread;
+   ALooper     *looper;   /* the reader thread's own */
+   AInputQueue *queue;    /* the queue being read, or NULL */
+   int          wake[2];  /* reader to main thread, LOOPER_ID_INPUT */
+   bool         ready;
+   bool         threaded; /* false: the main thread reads the queue itself */
+   unsigned     head;
+   unsigned     tail;
+   unsigned     dropped;
+   sr_event_t   ring[SR_RING];
+} sr_reader_t;
+
+static sr_reader_t sr_reader = { NULL, NULL, NULL, NULL, NULL, { -1, -1 } };
+
+/* The macros near the top route these two through pointers that the input
+ * driver fills in; the reader runs whether or not a driver exists, and the
+ * platform has had both since API 14. */
+#pragma push_macro("AMotionEvent_getAxisValue")
+#pragma push_macro("AMotionEvent_getButtonState")
+#undef AMotionEvent_getAxisValue
+#undef AMotionEvent_getButtonState
+static void sr_copy_motion(const AInputEvent *event, sr_event_t *e)
+{
+   size_t i;
+   size_t ptr;
+   size_t count     = AMotionEvent_getPointerCount(event);
+
+   e->action        = AMotionEvent_getAction(event);
+   e->button_state  = AMotionEvent_getButtonState(event);
+   e->event_time    = AMotionEvent_getEventTime(event);
+   e->down_time     = AMotionEvent_getDownTime(event);
+
+   if (count > SR_POINTERS)
+      count         = SR_POINTERS;
+   e->pointer_count = (int32_t)count;
+
+   for (i = 0; i < count; i++)
+   {
+      e->pointer_id[i] = AMotionEvent_getPointerId(event, i);
+      e->x[i]          = AMotionEvent_getX(event, i);
+      e->y[i]          = AMotionEvent_getY(event, i);
+   }
+
+   /* the handlers read the axes at the pointer the action names */
+   ptr = (size_t)e->action >> AMOTION_EVENT_ACTION_POINTER_INDEX_SHIFT;
+   if (ptr < count)
+   {
+      e->axis[SR_AXIS_X]          = AMotionEvent_getAxisValue(event, AXIS_X, ptr);
+      e->axis[SR_AXIS_Y]          = AMotionEvent_getAxisValue(event, AXIS_Y, ptr);
+      e->axis[SR_AXIS_Z]          = AMotionEvent_getAxisValue(event, AXIS_Z, ptr);
+      e->axis[SR_AXIS_RZ]         = AMotionEvent_getAxisValue(event, AXIS_RZ, ptr);
+      e->axis[SR_AXIS_HAT_X]      = AMotionEvent_getAxisValue(event, AXIS_HAT_X, ptr);
+      e->axis[SR_AXIS_HAT_Y]      = AMotionEvent_getAxisValue(event, AXIS_HAT_Y, ptr);
+      e->axis[SR_AXIS_LTRIGGER]   = AMotionEvent_getAxisValue(event, AXIS_LTRIGGER, ptr);
+      e->axis[SR_AXIS_RTRIGGER]   = AMotionEvent_getAxisValue(event, AXIS_RTRIGGER, ptr);
+      e->axis[SR_AXIS_BRAKE]      = AMotionEvent_getAxisValue(event, AXIS_BRAKE, ptr);
+      e->axis[SR_AXIS_GAS]        = AMotionEvent_getAxisValue(event, AXIS_GAS, ptr);
+      e->axis[SR_AXIS_VSCROLL]    = AMotionEvent_getAxisValue(event,
+            AMOTION_EVENT_AXIS_VSCROLL, ptr);
+      e->axis[SR_AXIS_RELATIVE_X] = AMotionEvent_getAxisValue(event,
+            AMOTION_EVENT_AXIS_RELATIVE_X, ptr);
+      e->axis[SR_AXIS_RELATIVE_Y] = AMotionEvent_getAxisValue(event,
+            AMOTION_EVENT_AXIS_RELATIVE_Y, ptr);
+   }
+}
+#pragma pop_macro("AMotionEvent_getButtonState")
+#pragma pop_macro("AMotionEvent_getAxisValue")
+
+/* A stick, trigger or hat move: the motion events the stock poll hands to
+ * engine_handle_dpad, which only stores the latest axis values. */
+static bool sr_is_stick_move(const sr_event_t *e)
+{
+   return e->type == AINPUT_EVENT_TYPE_MOTION
+      && !(e->source & (AINPUT_SOURCE_TOUCHPAD | AINPUT_SOURCE_TOUCHSCREEN
+               | AINPUT_SOURCE_MOUSE_RELATIVE | AINPUT_SOURCE_STYLUS
+               | AINPUT_SOURCE_MOUSE))
+      && (e->action & AMOTION_EVENT_ACTION_MASK) == AMOTION_EVENT_ACTION_MOVE;
+}
+
+/* Under sr_reader.lock. */
+static void sr_ring_put(const sr_event_t *e)
+{
+   /* A stick move still waiting from the same device would only have its
+    * values replaced by this one, so this one takes its place. */
+   if (sr_reader.head != sr_reader.tail && sr_is_stick_move(e))
+   {
+      sr_event_t *last = &sr_reader.ring[(sr_reader.head - 1) & (SR_RING - 1)];
+      if (     sr_is_stick_move(last)
+            && last->device_id == e->device_id
+            && last->source    == e->source)
+      {
+         *last = *e;
+         return;
+      }
+   }
+
+   /* full only if the main thread has not polled for a long time */
+   if (sr_reader.head - sr_reader.tail == SR_RING)
+   {
+      sr_reader.tail++;
+      sr_reader.dropped++;
+   }
+
+   sr_reader.ring[sr_reader.head & (SR_RING - 1)] = *e;
+   sr_reader.head++;
+}
+
+/* Slickrock: Sidephone SP01 Mini Controller ghost filter.
+ *
+ * The phone scans its keypad tiles through one controller,
+ * "gxa535_keyboard". The Mini Controller's ten buttons sit on a 3 by 4
+ * grid of shared lines with no diodes, so three held buttons that form an
+ * L join the lines of a fourth, and the controller reports that fourth
+ * button as pressed. The grid below was worked out from raw evdev
+ * captures on an SP01 (Oct 2026). It accounts for every Start and Select
+ * the controller reported while nobody touched them, 46 across two
+ * recordings. A ghost runs through three contacts in series, so a
+ * predicted ghost sometimes flickers or fails to show, as observed.
+ *
+ *        col 0    col 1    col 2    col 3
+ * row 0  B        A        X        Start
+ * row 1  Y        -        Down     Left
+ * row 2  Select   -        Right    Up
+ *
+ * (Android key codes: BUTTON_B is the tile's BTN_EAST, BUTTON_A BTN_SOUTH,
+ * BUTTON_X BTN_NORTH, BUTTON_Y BTN_WEST.)
+ *
+ * The changes of one scan reach the reader a millisecond or two apart, and
+ * a ghost can come before the key that makes it, so a scan is gathered
+ * until the keypad has been quiet for SR_KP_QUIET_NS and judged whole. A
+ * key the other held keys explain is a ghost and is held back. It goes on
+ * late only if it stays unexplained for SR_KP_LATE_NS, which a ghost never
+ * survives: the controller drops it in the same scan as the key that made
+ * it. When new keys explain each other, the likeliest are taken as real:
+ * a key pressed in the last SR_KP_RECENT_NS first (that is the one being
+ * mashed), then a d-pad direction before a face button, Start and Select
+ * last.
+ *
+ * A ghost can also run a whole scan ahead of its cause: the controller
+ * reads the rows in turn, so a contact closing after its own row was read
+ * but before the ghost's row shows as the ghost first and as itself one
+ * scan (about 28 ms) later. With two keys down nothing explains a third,
+ * so a Start or Select arriving then was passed on as a press, and once a
+ * press is live the chord rule below never took it back (sr1). RetroArch
+ * blocks every game button while its hotkey enable, Start or Select on
+ * this tile, is held longer than input_hotkey_block_delay (five frames),
+ * which is how a leaked ghost turned into dead buttons. Now a Start or
+ * Select arriving with two other keys down waits SR_KP_MENU_WAIT_NS for a
+ * third, and one that went live just before a chord that explains it is
+ * released. */
+#define SR_KP_KEYS      10
+#define SR_KP_SCAN_NS    5000000LL /* one scan's events, by event time */
+#define SR_KP_QUIET_NS   5000000LL /* scans are about 28 ms apart */
+#define SR_KP_LATE_NS   40000000LL
+#define SR_KP_RECENT_NS 500000000LL
+#define SR_KP_MENU_WAIT_NS    60000000LL /* two scans, for the key that makes a ghost */
+#define SR_KP_MENU_RECENT_NS 150000000LL /* a Start/Select live this briefly is still suspect */
+#define SR_KP_SLOTS      2         /* the tile, and any app's copy of it */
+#define SR_KP_KNOWN      16
+
+static const int32_t sr_kp_code[SR_KP_KEYS] = {
+   AKEYCODE_BUTTON_B,      AKEYCODE_BUTTON_A, AKEYCODE_BUTTON_X,
+   AKEYCODE_BUTTON_START,  AKEYCODE_BUTTON_Y, AKEYCODE_DPAD_DOWN,
+   AKEYCODE_DPAD_LEFT,     AKEYCODE_BUTTON_SELECT,
+   AKEYCODE_DPAD_RIGHT,    AKEYCODE_DPAD_UP };
+static const uint8_t sr_kp_row[SR_KP_KEYS]  = { 0, 0, 0, 0, 1, 1, 1, 2, 2, 2 };
+static const uint8_t sr_kp_col[SR_KP_KEYS]  = { 0, 1, 2, 3, 0, 2, 3, 0, 2, 3 };
+/* what it costs to call a key real: d-pad 1, face 2, Start/Select 9 */
+static const uint8_t sr_kp_cost[SR_KP_KEYS] = { 2, 2, 2, 9, 2, 1, 1, 9, 1, 1 };
+static const char *sr_kp_name[SR_KP_KEYS] = {
+   "B", "A", "X", "Start", "Y", "Down", "Left", "Select", "Right", "Up" };
+#define SR_KP_MENU ((uint16_t)((1 << 3) | (1 << 7))) /* Start, Select */
+
+typedef struct sr_keypad
+{
+   int32_t    device_id;
+   bool       used;
+   uint16_t   raw;              /* keys the controller reports held */
+   uint16_t   live;             /* keys passed on as held */
+   uint16_t   held_back;        /* dropped since the last log line */
+   int        scan_n;           /* events of the scan being gathered */
+   int64_t    scan_time;        /* event time of its first event */
+   int64_t    last_arrival;
+   sr_event_t scan[SR_KP_KEYS * 2];
+   sr_event_t down[SR_KP_KEYS]; /* each key's last DOWN */
+   int64_t    late_since[SR_KP_KEYS];
+   int64_t    live_since[SR_KP_KEYS]; /* when each live key was passed on */
+   int64_t    prev_down[SR_KP_KEYS]; /* event time of the DOWN before it */
+   unsigned   ghosts;
+} sr_keypad_t;
+
+/* How long a waiting key is given before it is believed on its own. */
+static int64_t sr_kp_late_ns(int i)
+{
+   return (SR_KP_MENU >> i & 1) ? SR_KP_MENU_WAIT_NS : SR_KP_LATE_NS;
+}
+
+/* reader thread only, or the main thread when there is no reader */
+static sr_keypad_t sr_keypads[SR_KP_SLOTS];
+static struct { int32_t id; int8_t is; } sr_kp_known[SR_KP_KNOWN];
+static int sr_kp_known_n = 0;
+
+static int64_t sr_now_ns(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+static int sr_kp_index(int32_t keycode)
+{
+   int i;
+   for (i = 0; i < SR_KP_KEYS; i++)
+      if (sr_kp_code[i] == keycode)
+         return i;
+   return -1;
+}
+
+/* The device's name comes over JNI, once per device id. */
+static bool sr_kp_is_keypad(int32_t device_id)
+{
+   int i;
+   char name[256];
+   int vid = 0, pid = 0;
+   bool is = false;
+   JNIEnv *env;
+
+   for (i = 0; i < sr_kp_known_n; i++)
+      if (sr_kp_known[i].id == device_id)
+         return sr_kp_known[i].is != 0;
+
+   name[0] = '\0';
+   if ((env = (JNIEnv*)jni_thread_getenv())
+         && (*env)->PushLocalFrame(env, 16) == 0)
+   {
+      if (android_input_lookup_name(name, &vid, &pid,
+               sizeof(name), device_id))
+         is = string_is_equal(name, "gxa535_keyboard");
+      (*env)->PopLocalFrame(env, NULL);
+   }
+
+   if (sr_kp_known_n < SR_KP_KNOWN)
+   {
+      sr_kp_known[sr_kp_known_n].id   = device_id;
+      sr_kp_known[sr_kp_known_n++].is = is ? 1 : 0;
+   }
+   return is;
+}
+
+/* Every key whose row and column the held keys join. */
+static uint16_t sr_kp_closure(uint16_t held)
+{
+   uint8_t rows[SR_KP_KEYS], cols[SR_KP_KEYS];
+   uint16_t out = 0;
+   int n = 0, i, a, b, merged;
+
+   for (i = 0; i < SR_KP_KEYS; i++)
+      if (held >> i & 1)
+      {
+         rows[n] = (uint8_t)(1 << sr_kp_row[i]);
+         cols[n] = (uint8_t)(1 << sr_kp_col[i]);
+         n++;
+      }
+
+   do
+   {
+      merged = 0;
+      for (a = 0; a < n; a++)
+         for (b = a + 1; b < n; b++)
+            if ((rows[a] & rows[b]) || (cols[a] & cols[b]))
+            {
+               rows[a] |= rows[b];
+               cols[a] |= cols[b];
+               rows[b]  = rows[n - 1];
+               cols[b]  = cols[n - 1];
+               n--;
+               b--;
+               merged   = 1;
+            }
+   } while (merged);
+
+   for (i = 0; i < SR_KP_KEYS; i++)
+      for (a = 0; a < n; a++)
+         if ((rows[a] >> sr_kp_row[i] & 1) && (cols[a] >> sr_kp_col[i] & 1))
+            out |= (uint16_t)(1 << i);
+   return out;
+}
+
+static void sr_kp_emit(const sr_event_t *e, int32_t action)
+{
+   sr_event_t out = *e;
+   out.action     = action;
+   sr_ring_put(&out);
+}
+
+/* Under sr_reader.lock. Picks the held keys that are real. 'fresh' holds
+ * the keys that went down in this scan; the others waiting were held
+ * back before and only go on late. */
+static void sr_kp_settle(sr_keypad_t *kp, uint16_t fresh, int64_t now)
+{
+   const uint16_t menu = SR_KP_MENU;
+   uint16_t wait  = kp->raw & ~kp->live;
+   uint16_t need  = kp->raw;
+   uint16_t best  = 0;
+   int best_cost  = -1;
+   int others     = __builtin_popcount(kp->raw & ~menu);
+   unsigned sub;
+   int i;
+
+   /* Start or Select under a chord of three or more is not a press anyone
+    * makes in a game; it waits out the chord and goes on late if it is
+    * still held after. One passed on moments before the chord formed was
+    * the ghost running ahead of it (see above): it is taken back. */
+   if (others >= 3)
+   {
+      need &= ~menu;
+      wait &= ~menu;
+      for (i = 0; i < SR_KP_KEYS; i++)
+      {
+         uint16_t bit = (uint16_t)(1 << i);
+         if (!(menu & bit))
+            continue;
+         if ((kp->raw & bit) && (fresh & bit || kp->late_since[i]))
+         {
+            kp->ghosts++;
+            kp->held_back |= bit;
+         }
+         kp->late_since[i] = 0;
+         if (     (kp->live & bit)
+               && kp->live_since[i]
+               && now - kp->live_since[i] < SR_KP_MENU_RECENT_NS
+               && (sr_kp_closure((uint16_t)(kp->raw & ~menu)) & bit))
+         {
+            kp->live      &= ~bit;
+            kp->live_since[i] = 0;
+            kp->ghosts++;
+            kp->held_back |= bit;
+            sr_kp_emit(&kp->down[i], AKEY_EVENT_ACTION_UP);
+         }
+      }
+   }
+   /* With two other keys down, a new Start or Select may be the ghost of a
+    * third key the controller has not reported yet. It waits for that key
+    * (SR_KP_MENU_WAIT_NS) and is believed only if none comes. */
+   else if (others >= 2)
+   {
+      for (i = 0; i < SR_KP_KEYS; i++)
+      {
+         uint16_t bit = (uint16_t)(1 << i);
+         if ((menu & bit) && (fresh & bit))
+         {
+            fresh &= ~bit;
+            if (!kp->late_since[i])
+               kp->late_since[i] = now;
+         }
+      }
+   }
+
+   if (!wait)
+      return;
+
+   /* the cheapest set of waiting keys that, taken as real, explains every
+    * held key; at most ten keys wait, so every subset is tried */
+   sub = wait;
+   for (;;)
+   {
+      if ((sr_kp_closure((uint16_t)(kp->live | sub)) & need) == need)
+      {
+         int cost = 0;
+         for (i = 0; i < SR_KP_KEYS; i++)
+         {
+            if (!(sub >> i & 1))
+               continue;
+            if (fresh >> i & 1)
+            {
+               /* a key pressed moments ago is the one being mashed */
+               bool recent = kp->prev_down[i]
+                  && now - kp->prev_down[i] < SR_KP_RECENT_NS;
+               cost += 100 + sr_kp_cost[i] - (recent ? 3 : 0);
+            }
+            else
+               cost += 1000 + sr_kp_cost[i];
+         }
+         if (best_cost < 0 || cost < best_cost)
+         {
+            best_cost = cost;
+            best      = (uint16_t)sub;
+         }
+      }
+      if (!sub)
+         break;
+      sub = (sub - 1) & wait;
+   }
+
+   for (i = 0; i < SR_KP_KEYS; i++)
+   {
+      uint16_t bit = (uint16_t)(1 << i);
+      if (!(wait & bit))
+         continue;
+      if (!(best & bit))
+      {
+         /* explained by the others: a ghost, or a fourth corner no grid
+          * can tell from one */
+         if ((fresh & bit) || kp->late_since[i])
+         {
+            kp->ghosts++;
+            kp->held_back |= bit;
+         }
+         kp->late_since[i] = 0;
+         continue;
+      }
+      if (fresh & bit)
+      {
+         kp->live         |= bit;
+         kp->live_since[i] = now;
+         sr_kp_emit(&kp->down[i], AKEY_EVENT_ACTION_DOWN);
+         continue;
+      }
+      if (!kp->late_since[i])
+         kp->late_since[i] = now;
+      else if (now - kp->late_since[i] >= sr_kp_late_ns(i))
+      {
+         kp->late_since[i] = 0;
+         kp->live         |= bit;
+         kp->live_since[i] = now;
+         sr_kp_emit(&kp->down[i], AKEY_EVENT_ACTION_DOWN);
+      }
+   }
+}
+
+/* What was held back since the last line, and what was down at the time:
+ * one line per judged scan, so a dead button can be traced in logcat. */
+static void sr_kp_log(sr_keypad_t *kp)
+{
+   char dropped[64], held[80];
+   size_t d = 0, h = 0;
+   int i;
+
+   if (!kp->ghosts)
+      return;
+   dropped[0] = held[0] = '\0';
+   for (i = 0; i < SR_KP_KEYS; i++)
+   {
+      if ((kp->held_back >> i & 1) && d < sizeof(dropped) - 8)
+         d += (size_t)snprintf(dropped + d, sizeof(dropped) - d, "%s%s",
+               d ? " " : "", sr_kp_name[i]);
+      if ((kp->live >> i & 1) && h < sizeof(held) - 8)
+         h += (size_t)snprintf(held + h, sizeof(held) - h, "%s%s",
+               h ? " " : "", sr_kp_name[i]);
+   }
+   __android_log_print(ANDROID_LOG_INFO, "RetroArch",
+         "[Slickrock] Sidephone keypad: held back %s (%u), down: %s\n",
+         dropped, kp->ghosts, h ? held : "nothing");
+   kp->ghosts    = 0;
+   kp->held_back = 0;
+}
+
+/* Under sr_reader.lock: judges the scan gathered so far. */
+static void sr_kp_flush(sr_keypad_t *kp, int64_t now)
+{
+   uint16_t fresh = 0;
+   int n;
+
+   for (n = 0; n < kp->scan_n; n++)
+   {
+      const sr_event_t *e = &kp->scan[n];
+      int k               = sr_kp_index(e->keycode);
+      uint16_t bit        = (uint16_t)(1 << k);
+
+      if (e->action == AKEY_EVENT_ACTION_DOWN)
+      {
+         if (kp->raw & bit)
+         {
+            /* a repeat goes on only for a key that is live */
+            if (kp->live & bit)
+               sr_ring_put(e);
+            continue;
+         }
+         kp->raw         |= bit;
+         kp->prev_down[k] = kp->down[k].event_time;
+         kp->down[k]      = *e;
+         fresh           |= bit;
+      }
+      else if (e->action == AKEY_EVENT_ACTION_UP)
+      {
+         kp->raw          &= ~bit;
+         fresh            &= ~bit;
+         kp->late_since[k] = 0;
+         if (kp->live & bit)
+         {
+            kp->live         &= ~bit;
+            kp->live_since[k] = 0;
+            sr_ring_put(e);
+         }
+      }
+   }
+   kp->scan_n = 0;
+
+   sr_kp_settle(kp, fresh, now);
+   sr_kp_log(kp);
+}
+
+static sr_keypad_t *sr_kp_slot(int32_t device_id, int64_t now)
+{
+   int i, pick = 0;
+
+   for (i = 0; i < SR_KP_SLOTS; i++)
+      if (sr_keypads[i].used && sr_keypads[i].device_id == device_id)
+         return &sr_keypads[i];
+
+   /* a new device: a free slot, or the one heard from least recently,
+    * after letting go of anything it still had live */
+   for (i = 0; i < SR_KP_SLOTS; i++)
+   {
+      if (!sr_keypads[i].used)
+      {
+         pick = i;
+         break;
+      }
+      if (sr_keypads[i].last_arrival < sr_keypads[pick].last_arrival)
+         pick = i;
+   }
+
+   if (sr_keypads[pick].used)
+   {
+      sr_keypad_t *old = &sr_keypads[pick];
+      if (old->scan_n)
+         sr_kp_flush(old, now);
+      for (i = 0; i < SR_KP_KEYS; i++)
+         if (old->live >> i & 1)
+            sr_kp_emit(&old->down[i], AKEY_EVENT_ACTION_UP);
+   }
+
+   memset(&sr_keypads[pick], 0, sizeof(sr_keypads[pick]));
+   sr_keypads[pick].used      = true;
+   sr_keypads[pick].device_id = device_id;
+   return &sr_keypads[pick];
+}
+
+/* Under sr_reader.lock. A keypad key event joins the scan being gathered;
+ * one from a later scan closes that scan first. */
+static void sr_kp_feed(const sr_event_t *e)
+{
+   int64_t now     = sr_now_ns();
+   sr_keypad_t *kp = sr_kp_slot(e->device_id, now);
+
+   if (kp->scan_n
+         && (   e->event_time - kp->scan_time >  SR_KP_SCAN_NS
+             || e->event_time - kp->scan_time < -SR_KP_SCAN_NS
+             || kp->scan_n == SR_KP_KEYS * 2))
+      sr_kp_flush(kp, now);
+
+   if (!kp->scan_n)
+      kp->scan_time = e->event_time;
+   kp->scan[kp->scan_n++] = *e;
+   kp->last_arrival       = now;
+}
+
+/* Under sr_reader.lock: scans that have gone quiet, and late accepts that
+ * are due. True if anything went to the ring. */
+static bool sr_kp_tick(int64_t now)
+{
+   unsigned head = sr_reader.head;
+   int s, i;
+
+   for (s = 0; s < SR_KP_SLOTS; s++)
+   {
+      sr_keypad_t *kp = &sr_keypads[s];
+      if (!kp->used)
+         continue;
+      if (kp->scan_n && now - kp->last_arrival >= SR_KP_QUIET_NS)
+         sr_kp_flush(kp, now);
+      for (i = 0; i < SR_KP_KEYS; i++)
+         if (kp->late_since[i] && now - kp->late_since[i] >= sr_kp_late_ns(i))
+         {
+            sr_kp_settle(kp, 0, now);
+            sr_kp_log(kp);
+            break;
+         }
+   }
+
+   return sr_reader.head != head;
+}
+
+/* Milliseconds until the keypad next needs a look, or -1 for never. */
+static int sr_kp_timeout_ms(int64_t now)
+{
+   int64_t due = 0;
+   int s, i;
+
+   for (s = 0; s < SR_KP_SLOTS; s++)
+   {
+      sr_keypad_t *kp = &sr_keypads[s];
+      if (!kp->used)
+         continue;
+      if (kp->scan_n)
+      {
+         int64_t t = kp->last_arrival + SR_KP_QUIET_NS;
+         if (!due || t < due)
+            due = t;
+      }
+      for (i = 0; i < SR_KP_KEYS; i++)
+         if (kp->late_since[i])
+         {
+            int64_t t = kp->late_since[i] + sr_kp_late_ns(i);
+            if (!due || t < due)
+               due = t;
+         }
+   }
+   if (!due)
+      return -1;
+   if (due <= now)
+      return 0;
+   return (int)((due - now + 999999LL) / 1000000LL);
+}
+
+/* Under sr_reader.lock. Copies the event when there is something to apply
+ * and returns how it is to be finished. */
+static int32_t sr_reader_take(const AInputEvent *event)
+{
+   sr_event_t e;
+   int32_t handled = 1;
+
+   memset(&e, 0, sizeof(e));
+   e.type      = AInputEvent_getType(event);
+   e.device_id = AInputEvent_getDeviceId(event);
+   e.source    = AInputEvent_getSource(event);
+
+   switch (e.type)
+   {
+      case AINPUT_EVENT_TYPE_KEY:
+         e.keycode = AKeyEvent_getKeyCode(event);
+         if (!e.keycode)
+            return 1; /* stock ignores these too */
+         if (     e.keycode == AKEYCODE_VOLUME_UP
+               || e.keycode == AKEYCODE_VOLUME_DOWN)
+         {
+            handled = 0;
+            if (AKeyEvent_getFlags(event)
+                  & SLICKROCK_AKEY_EVENT_FLAG_PREDISPATCH)
+               return 0;
+         }
+         e.action     = AKeyEvent_getAction(event);
+         e.meta_state = AKeyEvent_getMetaState(event);
+         e.event_time = AKeyEvent_getEventTime(event);
+         if (     sr_kp_index(e.keycode) >= 0
+               && sr_kp_is_keypad(e.device_id))
+         {
+            sr_kp_feed(&e);
+            return handled;
+         }
+         break;
+      case AINPUT_EVENT_TYPE_MOTION:
+         sr_copy_motion(event, &e);
+         break;
+      default:
+         return 1;
+   }
+
+   sr_ring_put(&e);
+   return handled;
+}
+
+/* Reader thread, or the main thread when there is no reader. */
+static void sr_reader_drain_queue(void)
+{
+   AInputEvent *event = NULL;
+   bool         taken = false;
+
+   slock_lock(sr_reader.lock);
+   if (sr_reader.queue)
+   {
+      while (AInputQueue_getEvent(sr_reader.queue, &event) >= 0)
+      {
+         int32_t handled = sr_reader_take(event);
+         AInputQueue_finishEvent(sr_reader.queue, event, handled);
+         taken = true;
+      }
+   }
+   /* keypad scans that have gone quiet, late accepts that are due */
+   if (sr_kp_tick(sr_now_ns()))
+      taken = true;
+   slock_unlock(sr_reader.lock);
+
+   if (taken && sr_reader.threaded)
+   {
+      char knock = 0;
+      /* a full pipe already has the main thread due to wake */
+      if (write(sr_reader.wake[1], &knock, 1) < 0) { }
+   }
+}
+
+static void sr_reader_thread(void *data)
+{
+   ALooper *looper = ALooper_prepare(ALOOPER_PREPARE_ALLOW_NON_CALLBACKS);
+
+   ALooper_acquire(looper);
+
+   slock_lock(sr_reader.lock);
+   sr_reader.looper = looper;
+   sr_reader.ready  = true;
+   scond_signal(sr_reader.cond);
+   slock_unlock(sr_reader.lock);
+
+   for (;;)
+   {
+      int timeout, ident;
+
+      /* the keypad filter may be waiting for a scan to go quiet */
+      slock_lock(sr_reader.lock);
+      timeout = sr_kp_timeout_ms(sr_now_ns());
+      slock_unlock(sr_reader.lock);
+
+      ident = ALooper_pollOnce(timeout, NULL, NULL, NULL);
+
+      if (ident == LOOPER_ID_INPUT || ident == ALOOPER_POLL_TIMEOUT)
+         sr_reader_drain_queue();
+      else if (ident == ALOOPER_POLL_ERROR)
+         usleep(1000);
+   }
+}
+
+/* Main thread, once. If the thread cannot be had, the queue stays on the
+ * main looper and the main thread reads it through the same path. */
+static void sr_reader_start(struct android_app *android_app)
+{
+   if (sr_reader.lock)
+      return;
+
+   sr_reader.lock = slock_new();
+   sr_reader.cond = scond_new();
+
+   if (pipe(sr_reader.wake) != 0)
+   {
+      sr_reader.wake[0] = sr_reader.wake[1] = -1;
+      return;
+   }
+   fcntl(sr_reader.wake[0], F_SETFL, O_NONBLOCK);
+   fcntl(sr_reader.wake[1], F_SETFL, O_NONBLOCK);
+   fcntl(sr_reader.wake[0], F_SETFD, FD_CLOEXEC);
+   fcntl(sr_reader.wake[1], F_SETFD, FD_CLOEXEC);
+
+   if (!(sr_reader.thread = sthread_create(sr_reader_thread, NULL)))
+   {
+      close(sr_reader.wake[0]);
+      close(sr_reader.wake[1]);
+      sr_reader.wake[0] = sr_reader.wake[1] = -1;
+      return;
+   }
+
+   slock_lock(sr_reader.lock);
+   while (!sr_reader.ready)
+      scond_wait(sr_reader.cond, sr_reader.lock);
+   slock_unlock(sr_reader.lock);
+
+   ALooper_addFd(android_app->looper, sr_reader.wake[0], LOOPER_ID_INPUT,
+         ALOOPER_EVENT_INPUT, NULL, NULL);
+   sr_reader.threaded = true;
+}
+
+/* Main thread, from APP_CMD_INPUT_CHANGED. */
+static void sr_reader_set_queue(struct android_app *android_app,
+      AInputQueue *queue)
+{
+   sr_reader_start(android_app);
+
+   slock_lock(sr_reader.lock);
+   if (sr_reader.queue)
+      AInputQueue_detachLooper(sr_reader.queue);
+   sr_reader.queue = queue;
+   if (queue)
+      AInputQueue_attachLooper(queue,
+            sr_reader.threaded ? sr_reader.looper : android_app->looper,
+            LOOPER_ID_INPUT, NULL, NULL);
+   slock_unlock(sr_reader.lock);
+}
+
+/* Main thread: LOOPER_ID_INPUT fired. Takes the reader's knock, or reads
+ * the queue when there is no reader. The copies wait in the ring. */
+static void sr_reader_service(void)
+{
+   if (sr_reader.threaded)
+   {
+      char knocks[64];
+      while (read(sr_reader.wake[0], knocks, sizeof(knocks)) > 0) { }
+   }
+   else
+      sr_reader_drain_queue();
+}
+
+/* Main thread, when the activity goes away: the queue is not read again. */
+void android_input_reader_release(void)
+{
+   if (!sr_reader.lock)
+      return;
+
+   slock_lock(sr_reader.lock);
+   if (sr_reader.queue)
+      AInputQueue_detachLooper(sr_reader.queue);
+   sr_reader.queue = NULL;
+   slock_unlock(sr_reader.lock);
+}
